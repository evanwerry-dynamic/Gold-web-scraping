# ── Polymarket / Polygon ──────────────────────────────────────────────────────
POLYGON_PRIVATE_KEY=0x...your_eoa_private_key_here
CLOB_API_KEY=...
CLOB_SECRET=...
CLOB_PASS_PHRASE=...
CLOB_NONCE=0

# ── Feed URLs ─────────────────────────────────────────────────────────────────
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
POLYGON_RPC_PRIMARY=https://polygon-rpc.com
POLYGON_RPC_FALLBACK=https://rpc.ankr.com/polygon

# ── Claude (nightly recalibration) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8000

# ── Bot settings (overrides code defaults) ───────────────────────────────────
INITIAL_BANKROLL=500
PAPER_TRADING=true
MIN_DELTA_THRESHOLD=0.001
MIN_EDGE_NET=0.05
ENTRY_SECONDS_BEFORE_CLOSE=60
MAX_TRADE_PCT=0.03
